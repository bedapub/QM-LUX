    container:
        config["qmlux_image"]
    shell:
        """
        python -m qm_lux.cli prediction --attribute SRN \
            --method {wildcards.method} --descriptor {wildcards.descriptor} \
            --input {input.model_folder} --pkl {input.pkl} --csv {output.csv} \
            --srn {input.file}
       """

rule get_results:
    input:
        pkl=rules.uvvis.output.pkl,
        csv=rules.prediction.output.csv,
        uv=rules.uvvis.output.dir,
    output:
        os.path.join(outdir, "{descriptor}.{method}", "failed_molecules.txt"),
        report(os.path.join(outdir, "{descriptor}.{method}", "results_ML_with_mol_UV.html"), caption="report/results_ml_html.rst", category="Results"),
    log:
        "logs/get_results_{descriptor}.{method}.log",
    params:
        indir=os.path.join(outdir),
        mldir=os.path.join(outdir, "data_ml"),
        outdir=os.path.join(outdir, "{descriptor}.{method}"),
    localrule: True
    container:
        config["qmlux_image"]
    shell:
        """
        # Symlink so get_results can locate the output directory by a fixed name.
        # This breaks if multiple descriptor/method combinations are run simultaneously.
        cd {params.mldir}
        ln -s -f ../{wildcards.descriptor}.{wildcards.method} ML_results
        cd -           
 
        python -m qm_lux.cli get_results --input {params.indir} --output {params.outdir}

        mv {params.mldir}/Failed_molecules.txt {params.outdir}/failed_molecules.txt
        mv {params.mldir}/results_ML_with_mol_UV.html {params.outdir}/results_ML_with_mol_UV.html
        """

rule summarize_results:
    input:
        html=expand(os.path.join(outdir, "{descriptor}.{method}", "results_ML_with_mol_UV.html"),
                   descriptor=config["model_descriptor"], method=config["model_method"]),
        txt=expand(os.path.join(outdir, "{descriptor}.{method}", "failed_molecules.txt"),
                   descriptor=config["model_descriptor"], method=config["model_method"]),
    output:
        summary=os.path.join(outdir, "summary.csv"),
    params:
        indir=os.path.join(outdir),
    localrule: True
    shell:
        """
        ./scripts/results.sh {params.indir} > {output.summary}
        """

rule report_tables:
    """Convert CSV/TXT workflow outputs to HTML for inline display in the Snakemake report."""
    input:
        summary=os.path.join(outdir, "summary.csv"),
        failed=expand(
            os.path.join(outdir, "{descriptor}.{method}", "failed_molecules.txt"),
            descriptor=config["model_descriptor"],
            method=config["model_method"],
        ),
        uvvis=os.path.join(outdir, "data_ml", "UVvis.csv"),
    output:
        summary_html=report(
            os.path.join(outdir, "summary.html"),
            caption="report/summary_csv.rst",
            category="Results",
        ),
        failed_html=report(
            os.path.join(outdir, "failed_molecules.html"),
            caption="report/failed_molecules.rst",
            category="Results",
        ),
        uvvis_html=report(
            os.path.join(outdir, "UVvis.html"),
            caption="report/methods.rst",
            category="Results",
        ),
    localrule: True
    run:
        import csv
        import pathlib

        def csv_to_html(path, max_rows=500):
            with open(path, newline="") as f:
                rows = list(csv.reader(f))
            if not rows:
                return "<p><em>Empty table.</em></p>"
            headers, data = rows[0], rows[1:]
            total = len(data)
            data = data[:max_rows]
            note = (
                f"<p><em>Showing first {max_rows} of {total} rows. "
                f"Download the CSV for the full dataset.</em></p>"
                if total > max_rows
                else ""
            )
            th = "".join(f"<th style='padding:4px 8px;border:1px solid #ccc'>{h}</th>" for h in headers)
            trs = "".join(
                "<tr>"
                + "".join(f"<td style='padding:4px 8px;border:1px solid #ccc'>{c}</td>" for c in row)
                + "</tr>"
                for row in data
            )
            table = (
                "<table style='border-collapse:collapse;font-size:13px'>"
                f"<thead><tr>{th}</tr></thead><tbody>{trs}</tbody></table>"
            )
            return note + table

        # summary.csv → HTML table
        pathlib.Path(output.summary_html).write_text(
            "<html><body>" + csv_to_html(input.summary) + "</body></html>"
        )

        # failed_molecules.txt → preformatted HTML
        txt = pathlib.Path(input.failed[0]).read_text().strip()
        msg = txt if txt else "No failed molecules."
        pathlib.Path(output.failed_html).write_text(
            "<html><body><pre style='font-family:monospace'>" + msg + "</pre></body></html>"
        )

        # UVvis.csv → HTML table (capped at 500 rows)
        pathlib.Path(output.uvvis_html).write_text(
            "<html><body>" + csv_to_html(input.uvvis) + "</body></html>"
        )


# Generate with: snakemake --report
report: 'report/description.rst'
